# Copy this file to .env and populate the values before launching.
SITE_URL=http://localhost:3000
PORT=3000
# IMPORTANT: switch to true ONLY after verifying your real schedule, live HTTPS and Stripe setup
BOOKING_ENABLED=false
# Optional schedule override, days Sunday=0 ... Saturday=6, 24-hour format.
# WEEKLY_SCHEDULE_JSON={"0":[],"1":[["19:30","21:30"]],"2":[],"3":[],"4":[],"5":[],"6":[]}
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
BUSINESS_TIMEZONE=America/Chicago
# Comma-separated ISO local dates to remove from availability (e.g. 2026-11-26,2026-12-25)
BLOCKED_DATES=
# Optional: shared calendar feed for cross-calendar availability is NOT implemented; block appointments manually.
# Optional: SMTP for booking confirmation emails (Stripe receipt separately configured in Stripe dashboard)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ITECCS Tutoring <bookings@iteccs.com>
BOOKING_ADMIN_EMAIL=
# Optional free intro booking: only creates a reservation, never a payment.
ENABLE_FREE_INTRO=true
